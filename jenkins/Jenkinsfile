pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'docker --version'
                sh 'docker ps'
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh 'docker build -t infrapilot-frontend:latest -f docker/frontend.Dockerfile .'
            }
        }

        stage('Build Backend Image') {
            steps {
                sh 'docker build -t infrapilot-backend:latest -f docker/backend.Dockerfile .'
            }
        }

        stage('Build Nginx Image') {
            steps {
                sh 'docker build -t infrapilot-nginx:latest nginx'
            }
        }

        stage('Verify Images') {
            steps {
                sh 'docker images'
            }
        }

        stage('Deploy Containers') {
            steps {
                dir('docker') {
                    sh '''
                        if [ ! -f .env ]; then
                            echo "FLASK_APP=app.py" > .env
                            echo "FLASK_ENV=production" >> .env
                            echo "PORT=5000" >> .env
                            echo "DATABASE_NAME=infrapilot.db" >> .env
                            echo "API_URL=http://backend:5000" >> .env
                        fi

                        if docker compose version >/dev/null 2>&1; then
                            docker compose down
                            docker compose up -d --build
                        else
                            docker-compose down
                            docker-compose up -d --build
                        fi
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    sleep 10
                    curl --fail http://infrapilot-nginx/health
                '''
            }
        }
    }

    post {

        success {
            echo '🚀 InfraPilot deployed successfully!'
        }

        failure {
            echo '❌ Deployment failed.'
        }

        always {
            sh 'docker ps'
        }
    }
}